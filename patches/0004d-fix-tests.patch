++    assert "PHP/8.1.0" in findings[0].description
++
++
++def test_no_disclosure_headers_no_findings():
++    req = _req()
++    resp = _resp(headers={"content-type": "text/html"})
++    findings = _check_version_disclosure(req, resp)
++    assert findings == []
++
++
