++
++
++# ─────────────────────────────────────────────────────────────────
++#  _check_version_disclosure
++# ─────────────────────────────────────────────────────────────────
++
++def test_server_header_disclosure():
++    req = _req()
++    resp = _resp(headers={"content-type": "text/html", "Server": "Apache/2.4.51"})
++    findings = _check_version_disclosure(req, resp)
++    assert len(findings) == 1
